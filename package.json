{
  "name": "reson8-frontend",
  "description": "A practice tracker for musicians",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "build": {
    "files": [
      "dist/**/*",
      "electron/dist/**/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
